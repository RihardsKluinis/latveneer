# Netlify headers — caching + security

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Film frames never change once generated — cache forever
/assets/film/frames/*
  Cache-Control: public, max-age=31536000, immutable

/assets/film/hd/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and optimized images — a week, revalidate in background
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# NOTE: deliberately NO caching rule for /assets/css/* or /assets/js/* —
# Netlify's default (ETag revalidation) makes style/script changes visible
# immediately after every deploy. A max-age here once kept a fixed
# stylesheet invisible to returning visitors for a day.
